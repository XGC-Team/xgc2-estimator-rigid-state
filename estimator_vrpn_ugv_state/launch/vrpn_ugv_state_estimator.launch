<?xml version="1.0"?>
<launch>
  <arg name="ns" default="ugv1"/>
  <arg name="config_file" default="$(find estimator_vrpn_ugv_state)/config/vrpn_ugv_state_estimator.yaml"/>
  <arg name="pose_source" default="vrpn"/>
  <arg name="imu_topic" default=""/>
  <arg name="pose_topic" default=""/>
  <arg name="world_frame" default="world"/>
  <arg name="estimator_frame" default="estimator"/>
  <arg name="publish_tf" default="true"/>

  <group ns="$(arg ns)">
    <node pkg="estimator_vrpn_ugv_state"
          type="vrpn_ugv_state_estimator_node"
          name="vrpn_ugv_state_estimator"
          output="screen"
          respawn="false"
          clear_params="true">
      <rosparam command="load" file="$(arg config_file)"/>
      <param name="pose_source" value="$(arg pose_source)"/>
      <param name="world_frame" value="$(arg world_frame)"/>
      <param name="estimator_frame" value="$(arg estimator_frame)"/>
      <param name="publish_tf" type="bool" value="$(arg publish_tf)"/>
      <param if="$(eval arg('imu_topic') != '')" name="imu_topic" value="$(arg imu_topic)"/>
      <param if="$(eval arg('pose_topic') != '')" name="vrpn_pose_topic" value="$(arg pose_topic)"/>
    </node>
  </group>
</launch>
