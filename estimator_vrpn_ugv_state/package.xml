<?xml version="1.0"?>
<package format="2">
  <name>estimator_vrpn_ugv_state</name>
  <version>1.0.0</version>
  <description>ROS1 VRPN planar UGV state estimator for XGC2 controllers.</description>

  <maintainer email="lxk@todo.todo">lxk</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rigid_state_estimator_msgs</depend>
  <depend>roscpp</depend>
  <depend>ros1_utils</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>libxgc2-math-dev</depend>
  <depend version_gte="0.1.2-1~focal">libxgc2-state-machine-dev</depend>
  <depend>eigen</depend>

  <test_depend>rostest</test_depend>
</package>
